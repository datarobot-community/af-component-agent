from unittest.mock import Mock

import pytest

from agent import MyAgent
from agent.myagent import (
    agent_planner,
    agent_writer,
    agents,
    crew,
    kickoff_inputs,
    task_plan,
    task_write,
    tasks,
    word_counter,
)


class TestMyAgentCrewAI:
    @pytest.fixture
    def agent(self):
        mock_llm = Mock()
        return MyAgent(llm=mock_llm, verbose=True)

    def test_module_level_agents_defined(self):
        """Test that module-level agents are properly defined."""
        assert len(agents) == 2
        assert agent_planner.role == "Planner"
        assert agent_writer.role == "Writer"

    def test_module_level_tasks_defined(self):
        """Test that module-level tasks are properly defined."""
        assert len(tasks) == 2
        assert task_plan.agent == agent_planner
        assert task_write.agent == agent_writer

    def test_crew_defined(self):
        """Test that the crew is properly configured."""
        assert crew is not None
        assert crew.agents == agents
        assert crew.tasks == tasks
        assert crew.stream is False, "Crew must not use stream=True"

    def test_kickoff_inputs(self):
        """Test kickoff_inputs produces correct dictionary."""
        result = kickoff_inputs("test topic")
        expected = {"topic": "test topic", "chat_history": ""}
        assert result == expected

    def test_myagent_is_crewai_agent_subclass(self):
        """Test that MyAgent inherits from CrewAIAgent."""
        from datarobot_genai.crewai.agent import CrewAIAgent

        assert issubclass(MyAgent, CrewAIAgent)

    def test_init_with_llm(self):
        """Test initialization with an LLM instance."""
        mock_llm = Mock()
        agent = MyAgent(llm=mock_llm, verbose=True)
        assert agent.llm == mock_llm
        assert agent.verbose is True

    def test_word_counter_tool(self):
        """Test that word_counter returns a word count string."""
        result = word_counter.run(text="hello world")
        assert "Word count: 2" in result

    def test_agents_have_word_counter(self):
        """Test that both agents include the word_counter tool."""
        planner_tool_names = [t.name for t in agent_planner.tools]
        writer_tool_names = [t.name for t in agent_writer.tools]
        assert "word_counter" in planner_tool_names
        assert "word_counter" in writer_tool_names

    def test_set_tools_propagates_to_agents(self):
        """Test that set_tools propagates tools to all sub-agents."""
        mock_llm = Mock()
        mock_tool = Mock()
        agent = MyAgent(llm=mock_llm, tools=[mock_tool])
        for sub_agent in agents:
            assert mock_tool in sub_agent.tools
