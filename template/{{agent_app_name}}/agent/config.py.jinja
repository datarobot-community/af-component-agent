"""
All configuration for the agent component. The config class handles
loading variables from environment, .env files, Pulumi outputs, and
DataRobot credentials automatically.

This is the authoritative configuration for the agent component. `datarobot-genai`
resolves the DataRobot connection and every LLM setting through this class instead
of its own defaults, so whatever is set here is what the agent runs with. Adding a
field here is all it takes to make it available; nothing needs to be registered.
"""

import json
import os
from typing import Any

from datarobot.core.config import DataRobotAppFrameworkBaseSettings
from pydantic import Field, ValidationInfo, field_validator, model_validator
from pydantic_settings import SettingsConfigDict


class Config(DataRobotAppFrameworkBaseSettings):  # type: ignore[misc]
    """
    This class finds variables in the priority order of: env
    variables (including Runtime Parameters), .env, file_secrets, then
    Pulumi output variables.
    """

    # DataRobot connection, shared by every LLM instance and DataRobot client.
    datarobot_endpoint: str = "https://app.datarobot.com/api/v2"
    datarobot_api_token: str | None = None

    # Settings for the "{{ _external_data.llm.llm_app_name|replace("-", "_") }}" LLM component instance, read from {{ _external_data.llm.llm_app_name|replace("-", "_")|upper }}_DEPLOYMENT_ID,
    # {{ _external_data.llm.llm_app_name|replace("-", "_")|upper }}_DEFAULT_MODEL and so on. A second LLM component brings its own set of
    # these fields under its own name.
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_deployment_id: str | None = None
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_default_model: str = "datarobot/azure/gpt-5-mini-2025-08-07"
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_nim_deployment_id: str | None = None
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_use_datarobot_llm_gateway: bool = True

    mcp_deployment_id: str | None = None
    external_mcp_url: str | None = None
{%- if use_agent_memory == 'mem0' %}
    mem0_api_key: str | None = None
{%- endif %}
    local_dev_port: int = Field(
        default=8842, validation_alias="{{agent_app_name|upper}}_PORT", ge=1, le=65535
    )

    # Prior conversation messages replayed to the agent. 0 disables history.
    max_history_messages: int = Field(
        default=20, ge=0, alias="datarobot_genai_max_history_messages"
    )
    # CrewAI only: report native tool-calling support for NIM models that LiteLLM has no
    # catalog entry for, so CrewAI uses API tool calls instead of the ReAct path.
    assume_native_tool_calling_when_unmapped: bool = False

    otel_entity_id: str = ""
    otel_exporter_otlp_endpoint: str = ""
    otel_exporter_otlp_headers: str = ""

    @field_validator("otel_exporter_otlp_headers", mode="before")
    @classmethod
    def _assemble_otel_headers(cls, v: object, info: ValidationInfo) -> object:
        if v:
            return v
        entity_id = (info.data or {}).get("otel_entity_id", "")
        api_token = os.environ.get("DATAROBOT_API_TOKEN", "")
        if entity_id and api_token:
            return f"x-datarobot-entity-id={entity_id},x-datarobot-api-key={api_token}"
        return v

    @model_validator(mode="before")
    @classmethod
    def replace_placeholder_values(cls, data: Any) -> Any:
        if isinstance(data, dict):
            for field_name, field_info in cls.model_fields.items():
                if data.get(field_name) == "SET_VIA_PULUMI_OR_MANUALLY":
                    data[field_name] = field_info.default
        return data


class ModerationSettings(DataRobotAppFrameworkBaseSettings):  # type: ignore[misc]
    """Moderation toggles, set like any other setting: in `.env`, or as runtime
    parameters on a deployment (declared by the infra from `.env` at deploy time)."""

    model_config = SettingsConfigDict(env_ignore_empty=True)

    disable_moderation: bool = False
    moderation_allow_external_access_tokens: bool = False


_RUNTIME_PARAM_PREFIX = "MLOPS_RUNTIME_PARAM_"


def publish_moderation_settings() -> None:
    """Make `ModerationSettings` visible to the `datarobot_moderation` middleware.

    The middleware reads these flags through `datarobot-moderations`, which only checks
    the `MLOPS_RUNTIME_PARAM_<NAME>` form that Custom Models sets. Locally and on the
    Workload API runtime only the plain `<NAME>` (or `.env`) is set, so write the
    prefixed form for each flag that was set and isn't already there. Must run before
    the workflow is built; `agent/__init__.py` calls it on import.
    """
    settings = ModerationSettings()
    for field in settings.model_fields_set:
        env_name = _RUNTIME_PARAM_PREFIX + field.upper()
        if env_name not in os.environ:
            value = getattr(settings, field)
            os.environ[env_name] = json.dumps({"type": "boolean", "payload": value})
