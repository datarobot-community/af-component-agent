"""
All configuration for the agent application. The config class handles
loading variables from environment, .env files, Pulumi outputs, and
DataRobot credentials automatically.
"""

import os
from typing import Any

from datarobot.core.config import DataRobotAppFrameworkBaseSettings
from pydantic import Field, ValidationInfo, field_validator, model_validator


class Config(DataRobotAppFrameworkBaseSettings):  # type: ignore[misc]
    """
    This class finds variables in the priority order of: env
    variables (including Runtime Parameters), .env, file_secrets, then
    Pulumi output variables.
    """

    # Fixed ecosystem-wide absolutes. These names never change and are shared by
    # every LLM instance.
    datarobot_endpoint: str = "https://app.datarobot.com/api/v2"
    datarobot_api_token: str | None = None

    # Per-LLM fields, namespaced by the component instance name. This app's default
    # instance is "{{ _external_data.llm.llm_app_name|replace("-", "_") }}"; adding
    # another LLM component adds its own namespaced set of these fields.
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_deployment_id: str | None = None
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_default_model: str = "datarobot/azure/gpt-5-mini-2025-08-07"
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_nim_deployment_id: str | None = None
    {{ _external_data.llm.llm_app_name|replace("-", "_") }}_use_datarobot_llm_gateway: bool = True
    mcp_deployment_id: str | None = None
    external_mcp_url: str | None = None
{%- if use_agent_memory == 'mem0' %}
    mem0_api_key: str | None = None
{%- endif %}
    local_dev_port: int = Field(
        default=8842, validation_alias="{{agent_app_name|upper}}_PORT", ge=1, le=65535
    )

    otel_entity_id: str = ""
    otel_exporter_otlp_endpoint: str = ""
    otel_exporter_otlp_headers: str = ""

    @field_validator("otel_exporter_otlp_headers", mode="before")
    @classmethod
    def _assemble_otel_headers(cls, v: object, info: ValidationInfo) -> object:
        if v:
            return v
        entity_id = (info.data or {}).get("otel_entity_id", "")
        api_token = os.environ.get("DATAROBOT_API_TOKEN", "")
        if entity_id and api_token:
            return f"x-datarobot-entity-id={entity_id},x-datarobot-api-key={api_token}"
        return v

    @model_validator(mode="before")
    @classmethod
    def replace_placeholder_values(cls, data: Any) -> Any:
        if isinstance(data, dict):
            for field_name, field_info in cls.model_fields.items():
                if data.get(field_name) == "SET_VIA_PULUMI_OR_MANUALLY":
                    data[field_name] = field_info.default
        return data


def _register_config_provider() -> None:
    """Register this app's Config as genai's authoritative LLM config source.

    Once registered, genai reads LLM config from this app config instead of its
    own env-only defaults. This is a no-op on a genai that predates the injection
    seam. The agent package is imported during NAT plugin discovery, before NAT
    validates the workflow config, so the provider is in place before genai first
    reads its config.
    """
    try:
        from datarobot_genai.core.config import register_config_provider
    except ImportError:
        return
    register_config_provider(
        lambda: Config(),
        default_llm_name="{{ _external_data.llm.llm_app_name|replace("-", "_") }}",
    )


_register_config_provider()
